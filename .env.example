# Корневой .env.example — копируется в .env у каждого сервиса (с правкой DATABASE_URL).
# Постгресы изолированы по портам: b2b=5433, mod=5434, b2c=5435.

# --- B2B ---
B2B_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/b2b

# --- Moderation ---
MODERATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/moderation

# --- B2C ---
B2C_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/b2c

# --- JWT (одинаковый секрет в b2b, mod, b2c — чтобы фронт мог проксировать токены) ---
JWT_ALGORITHM=HS256
JWT_SECRET=dev-secret-change-me-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Service-to-service auth (4 направления) ---
# Каждый ключ генерируется один раз и хранится у обоих участников связи.
B2B_TO_MOD_KEY=dev-b2b-to-mod-key-change-me
MOD_TO_B2B_KEY=dev-mod-to-b2b-key-change-me
B2C_TO_B2B_KEY=dev-b2c-to-b2b-key-change-me
B2B_TO_B2C_KEY=dev-b2b-to-b2c-key-change-me

# --- Service URLs (для http_clients) ---
B2B_URL=http://localhost:8001
MODERATION_URL=http://localhost:8002
B2C_URL=http://localhost:8003
